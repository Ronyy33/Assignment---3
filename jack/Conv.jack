/**
 * Conv.jack - Performs a 2D convolution operation on a flattened matrix
 * using a 3x3 kernel/filter with a configurable stride length.
 */
class Conv {
    /* Static variables shared across instances */
    static Array kernelMatrix;     // Flattened 3x3 filter coefficients
    static int strideStep;          // Number of elements to step by

    /* Instance fields */
    field Array inputTensor;        // Flattened source image/matrix (NxN)
    field Array outputTensor;       // Flattened resulting matrix after convolving
    field int inputSize;            // Dimensions of input matrix (N)

    /**
     * Instantiates a new Conv object.
     * @param N The dimension size of the square input matrix
     */
    constructor Conv new(int N) {
        var int dimOutput;
        var int lenOutput;

        let inputSize = N;
        let strideStep = 1;
        let inputTensor = Array.new(N * N);
        let dimOutput = ((N - 3) / strideStep) + 1;

        /* Verify boundary condition for output dimension */
        if (~(dimOutput < 1)) {
            let lenOutput = dimOutput * dimOutput;
        } else {
            do Memory.poke(0, -1);
            let lenOutput = 1;
        }

        let outputTensor = Array.new(lenOutput);

        /* Ensure filter kernel is allocated once */
        if (kernelMatrix = null) {
            let kernelMatrix = Array.new(9);
        }

        return this;
    }

    /**
     * Initializes the static 3x3 filter kernel with source values.
     * @param filterVals The flat array containing 9 values
     */
    method void initFilter(Array filterVals) {
        var int idx;
        let idx = 0;
        while (~(idx > 8)) {
            let kernelMatrix[idx] = filterVals[idx];
            let idx = idx + 1;
        }
        return;
    }

    /**
     * Populates the instance input tensor from a source array.
     * @param srcData The source array containing values
     * @param sideLen The side dimension of the source matrix
     */
    method void getArrayInput(Array srcData, int sideLen) {
        var int offset;
        var int elementsCount;

        let inputSize = sideLen;
        let elementsCount = sideLen * sideLen;
        let offset = 0;
        while (offset < elementsCount) {
            let inputTensor[offset] = srcData[offset];
            let offset = offset + 1;
        }
        return;
    }

    /**
     * Computes the dimension length of the output matrix.
     * @return The side size of the convoluted output matrix
     */
    method int calcOutputDim() {
        var int resultDim;
        let resultDim = ((inputSize - 3) / strideStep) + 1;
        return resultDim;
    }

    /**
     * Runs the 2D spatial convolution operation.
     * Computes multiply-accumulate values over each local 3x3 window.
     */
    method void conv2d() {
        var int dimOut;
        var int rOut, cOut;
        var int rIn, cIn;
        var int rF, cF;
        var int cellVal;
        var int outIdx;

        let dimOut = calcOutputDim();

        /* Guard check: make sure convolution window fits */
        if (~(dimOut > 0)) {
            do Memory.poke(0, -1);
            return;
        }

        let outIdx = 0;
        let rOut = 0;
        while (rOut < dimOut) {
            let cOut = 0;
            while (cOut < dimOut) {
                let cellVal = 0;
                let rF = 0;
                while (rF < 3) {
                    let cF = 0;
                    while (cF < 3) {
                        let rIn = (rOut * strideStep) + rF;
                        let cIn = (cOut * strideStep) + cF;
                        let cellVal = cellVal + (inputTensor[(rIn * inputSize) + cIn] * kernelMatrix[(rF * 3) + cF]);
                        let cF = cF + 1;
                    }
                    let rF = rF + 1;
                }
                let outputTensor[outIdx] = cellVal;
                let outIdx = outIdx + 1;
                let cOut = cOut + 1;
            }
            let rOut = rOut + 1;
        }
        return;
    }

    /**
     * Prints the output convoluted matrix to stdout in grid format.
     */
    method void printOutput() {
        var int limit;
        var int y, x, pos;

        let limit = calcOutputDim();
        let pos = 0;
        let y = 0;
        while (y < limit) {
            let x = 0;
            while (x < limit) {
                do Output.printInt(outputTensor[pos]);
                if (~(x = (limit - 1))) {
                    do Output.printChar(32); // print whitespace separator
                }
                let pos = pos + 1;
                let x = x + 1;
            }
            do Output.println();
            let y = y + 1;
        }
        return;
    }

    /**
     * Releases memory allocations held by the instance.
     */
    method void dispose() {
        do inputTensor.dispose();
        do outputTensor.dispose();
        do Memory.deAlloc(this);
        return;
    }
}
