/**
 * Main.jack - Entry point driver class for running the 2D Convolution.
 * Initializes a 5x5 matrix and a 3x3 edge-sharpening/detection filter.
 */
class Main {
    /**
     * Executes the main application driver.
     */
    function void main() {
        var Conv convolutionEngine;
        var Array inputMatrix;
        var Array filterKernel;
        var int elementIdx;

        /* Allocate input grid (5x5 matrix represented as 1D array of size 25) */
        let inputMatrix = Array.new(25);
        let elementIdx = 0;
        while (~(elementIdx = 25)) {
            let inputMatrix[elementIdx] = elementIdx + 1;
            let elementIdx = elementIdx + 1;
        }

        /* Define 3x3 filter kernel coefficients for sharpening edge detection */
        let filterKernel = Array.new(9);
        let filterKernel[0] = 0;
        let filterKernel[1] = -1;
        let filterKernel[2] = 0;
        let filterKernel[3] = -1;
        let filterKernel[4] = 5;
        let filterKernel[5] = -1;
        let filterKernel[6] = 0;
        let filterKernel[7] = -1;
        let filterKernel[8] = 0;

        /* Initialize convolution engine object with standard dimensions */
        let convolutionEngine = Conv.new(5);

        /* Configure matrix data and filter coefficients */
        do convolutionEngine.initFilter(filterKernel);
        do convolutionEngine.getArrayInput(inputMatrix, 5);

        /* Execute 2D convolution algorithm */
        do convolutionEngine.conv2d();

        /* Display execution banner and print the output matrix */
        do Output.printString("Conv Output (5x5, S=1):");
        do Output.println();
        do convolutionEngine.printOutput();

        /* Free resource allocations */
        do convolutionEngine.dispose();
        do inputMatrix.dispose();
        do filterKernel.dispose();

        return;
    }
}
